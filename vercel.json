{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist/oscar/browser",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "excludeFiles": "{data,tests,docs,supabase}/**"
    }
  },
  "crons": [{ "path": "/api/_maintenance", "schedule": "0 6 * * *" }],
  "rewrites": [
    { "source": "/api", "destination": "/api/index?__oscar_path=" },
    { "source": "/api/:path*", "destination": "/api/index?__oscar_path=:path*" },
    { "source": "/((?!api(?:/|$)|media(?:/|$)|.*\\.[^/]+$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" }
      ]
    },
    { "source": "/api/:path*", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/media/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/:file([A-Za-z0-9_-]+-[A-Za-z0-9]{8}\\.(?:js|css))", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
