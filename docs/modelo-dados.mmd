%% Modelo físico das 12 entidades de domínio do schema oscar_private.
%% Fonte: supabase/migrations/202610220001_oscar_private.sql e
%% docs/SQL_PARA_APLICAR_DEPOIS.txt (service_requests).
%% As linhas abaixo representam somente chaves estrangeiras reais.
%% serviceIds, itens de O.S., inspeções e vínculos das solicitações são
%% componentes do campo data JSONB; não são tabelas associativas neste schema.
erDiagram
  clients ||--o{ vehicles : clientid
  clients |o--o{ users : clientid_opcional
  suppliers |o--o{ parts : supplierid_opcional
  clients ||--o{ appointments : clientid
  vehicles ||--o{ appointments : vehicleid
  users ||--o{ appointments : mechanicid
  clients ||--o{ orders : clientid
  vehicles ||--o{ orders : vehicleid
  users ||--o{ orders : mechanicid
  appointments |o--o{ orders : appointmentid_opcional
  orders |o--o{ orders : originorderid_opcional
  orders ||--o{ budgets : orderid
  parts ||--o{ movements : partid
  orders |o--o{ movements : orderid_opcional
  suppliers |o--o{ movements : supplierid_opcional
  orders ||--o{ tickets : orderid
  clients ||--o{ tickets : clientid
  clients {
    bigint id PK
    jsonb data "nome, CPF, telefone, email e demais dados"
  }
  vehicles {
    bigint id PK
    bigint clientid FK
    jsonb data "placa, chassi, marca e modelo"
  }
  users {
    bigint id PK
    bigint clientid FK "opcional"
    text email UK
    text passwordhash
    jsonb data "nome, perfil e situacao"
  }
  services {
    bigint id PK
    jsonb data "nome, preco, duracao e itens de inspecao"
  }
  suppliers {
    bigint id PK
    jsonb data "nome, CNPJ, contato e prazo"
  }
  parts {
    bigint id PK
    bigint supplierid FK "opcional"
    jsonb data "codigo, valores, saldo e minimo"
  }
  appointments {
    bigint id PK
    bigint clientid FK
    bigint vehicleid FK
    bigint mechanicid FK
    jsonb data "data, horario e snapshot dos servicos"
  }
  orders {
    bigint id PK
    bigint clientid FK
    bigint vehicleid FK
    bigint mechanicid FK
    bigint appointmentid FK "opcional"
    bigint originorderid FK "opcional, autorrelacionamento"
    jsonb data "itens, inspecoes e historico"
  }
  budgets {
    bigint id PK
    bigint orderid FK
    jsonb data "itens, validade e decisoes"
  }
  movements {
    bigint id PK
    bigint partid FK
    bigint orderid FK "opcional"
    bigint supplierid FK "opcional"
    jsonb data "tipo, quantidade, data e autoria"
  }
  tickets {
    bigint id PK
    bigint orderid FK
    bigint clientid FK
    jsonb data "descricao, situacao e analise"
  }
  service_requests {
    bigint id PK
    jsonb data "contato, veiculo, servicos e vinculos confirmados"
  }

%% Tabelas de suporte (fora do recorte do diagrama): emails, audit, settings,
%% sessions, reset_tokens, rate_limits, backups, privacy_tombstones,
%% service_request_tombstones. O schema completo possui 21 tabelas.
%% sessions.userid e reset_tokens.userid possuem FK para users.id.
