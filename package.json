{
    "name": "oscar",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "node scripts/dev.mjs",
        "start:oscar-supabase": "node scripts/oscar-supabase.mjs start",
        "setup:oscar-supabase": "node scripts/oscar-supabase.mjs setup",
        "build": "ng build && node scripts/verify-csp-build.mjs",
        "watch": "ng build --watch --configuration development",
        "test": "node --test server/*.test.mjs tests/api*.mjs tests/postgres*.mjs tests/report-sql.test.mjs tests/cloud-flow.integration.mjs tests/admin-sql.test.mjs tests/oscar-supabase-setup.test.mjs tests/vercel-entry.test.mjs",
        "api": "node server/server.mjs",
        "test:api": "node --test server/*.test.mjs tests/api*.mjs",
        "verify:local": "node scripts/verify-local.mjs",
        "test:browser": "node scripts/browser-tests.mjs",
        "test:postgres": "node --test tests/postgres*.mjs tests/report-sql.test.mjs tests/cloud-flow.integration.mjs",
        "test:config": "node --test tests/admin-sql.test.mjs tests/vercel-entry.test.mjs",
        "admin:sql": "node scripts/admin-sql.mjs"
    },
    "prettier": {
        "printWidth": 100,
        "singleQuote": true,
        "overrides": [
            {
                "files": "*.html",
                "options": {
                    "parser": "angular"
                }
            }
        ]
    },
    "private": true,
    "dependencies": {
        "@angular/cdk": "^20.2.14",
        "@angular/common": "^20.3.0",
        "@angular/compiler": "^20.3.0",
        "@angular/core": "^20.3.0",
        "@angular/forms": "^20.3.0",
        "@angular/material": "^20.2.14",
        "@angular/platform-browser": "^20.3.0",
        "@angular/router": "^20.3.0",
        "@fontsource/dm-sans": "^5.3.0",
        "@fontsource/manrope": "^5.3.0",
        "@fontsource/material-symbols-rounded": "^5.3.9",
        "@vercel/functions": "^3.10.2",
        "pg": "^8.23.1",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0",
        "zone.js": "~0.15.0"
    },
    "devDependencies": {
        "@angular/build": "^20.3.40",
        "@angular/cli": "^20.3.40",
        "@angular/compiler-cli": "^20.3.0",
        "@electric-sql/pglite": "^0.5.10",
        "@playwright/test": "^1.61.1",
        "selfsigned": "^5.5.0",
        "typescript": "~5.9.2"
    },
    "overrides": {
        "@modelcontextprotocol/sdk": "^1.32.0",
        "vite": "^7.3.7"
    },
    "engines": {
        "node": "24.x"
    }
}
